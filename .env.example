# Synapse App Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Pillar 2: Socratic AI Edge Route ──────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Pillar 3: B2B Enterprise Telemetry Engine ──────────────────────────────────
# HMAC-SHA256 signing key — must match the key your enterprise client uses to
# verify the X-Telemetry-Signature header. Use a high-entropy random string.
WEBHOOK_SECRET_KEY=your-hmac-secret-here

# The enterprise webhook endpoint to dispatch telemetry to.
ENTERPRISE_ENDPOINT=https://your-enterprise-client.example.com/webhooks/synapse

# Optional: HTTP timeout in seconds for the dispatcher (default: 15)
# DISPATCHER_TIMEOUT=15

# ── Email access gate & Web Push ──────────────────────────────────────────────
# Generate VAPID keys once:  npx web-push generate-vapid-keys
# Public key is shipped to the browser; private key must stay server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact for push services, must be a mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com

# HMAC secret that signs the access cookie. 32+ random characters.
# Generate with:  openssl rand -base64 48
GATE_SECRET=replace-with-32-plus-random-characters

# Admin key required in the x-admin-key header for POST /api/push/send.
# Generate with:  openssl rand -hex 32
ADMIN_API_KEY=replace-with-random-admin-key

# Upstash Redis (already used by the uploaded-questions store) stores users and subscriptions.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
