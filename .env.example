# Synapse App Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Pillar 2: Socratic AI Edge Route ──────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Pillar 3: B2B Enterprise Telemetry Engine ──────────────────────────────────
# HMAC-SHA256 signing key — must match the key your enterprise client uses to
# verify the X-Telemetry-Signature header. Use a high-entropy random string.
WEBHOOK_SECRET_KEY=your-hmac-secret-here

# The enterprise webhook endpoint to dispatch telemetry to.
ENTERPRISE_ENDPOINT=https://your-enterprise-client.example.com/webhooks/synapse

# Optional: HTTP timeout in seconds for the dispatcher (default: 15)
# DISPATCHER_TIMEOUT=15
